<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://lookupengine.com/xaml"
    xmlns:membersGrid="clr-namespace:RevitLookup.Views.Styles.MembersGrid"
    xmlns:menus="clr-namespace:RevitLookup.UI.Framework.Menus;assembly=RevitLookup.UI.Framework">

    <membersGrid:DataGridCellTemplateSelector x:Key="DataGridCellTemplateSelector" />

    <ResourceDictionary.MergedDictionaries>

        <!-- Themes -->
        <ui:ThemesDictionary />
        <ui:ControlsDictionary />
        <menus:MenusDictionary />

        <!-- Controls -->
        <ResourceDictionary Source="pack://application:,,,/RevitLookup.UI.Framework;component/Controls/ContentPlaceholder/ContentPlaceholder.xaml" />

        <!-- Components Styles -->
        <ResourceDictionary Source="pack://application:,,,/RevitLookup;component/Views/Styles/ObjectsTree/TreeGroupTemplates.xaml" />
        <ResourceDictionary Source="pack://application:,,,/RevitLookup;component/Views/Styles/MembersGrid/DataGridGroupStyles.xaml" />
        <ResourceDictionary Source="pack://application:,,,/RevitLookup;component/Views/Styles/MembersGrid/DataGridRowStyle.xaml" />
        <ResourceDictionary Source="pack://application:,,,/RevitLookup;component/Views/Styles/MembersGrid/DataGridCellTemplate.xaml" />

    </ResourceDictionary.MergedDictionaries>

</ResourceDictionary>
